{
  "mcpServers": {
    "fsharp": {
      "command": "dotnet",
      "args": [
        "fslangmcp",
        "--project",
        "src/Domain/Domain.fsproj"
      ]
    },
    "domain": {
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "tools/Mcp"
      ]
    },
    "fsi": {
      "type": "sse",
      "url": "http://localhost:5020/sse"
    }
  }
}
